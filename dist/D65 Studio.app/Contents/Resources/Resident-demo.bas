10 REM AFTER START HAS INSTALLED THE RESIDENT READER
20 REM THIS SMALL PROGRAM RESERVES $C000 FOR MESSAGE DATA
30 BANK 0:FOR I=0 TO 15:POKE 7712+I,160:NEXT
40 A$="MESSAGE":FOR I=1 TO LEN(A$):POKE 7711+I,ASC(MID$(A$,I,1)):NEXT
50 POKE 7694,2:POKE 7695,0:POKE 7696,0:POKE 7697,192
60 SYS 5632
70 IF PEEK(7686)<>0 THEN PRINT "READ FAILED, STAGE";PEEK(7688):END
80 N=PEEK(7710)+256*PEEK(7711)
90 IF N=0 THEN PRINT "EMPTY FILE":END
100 FOR I=0 TO N-1:PRINT CHR$(PEEK(49152+I));:NEXT:PRINT
