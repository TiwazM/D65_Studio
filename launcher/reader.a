; D65 Studio resident read-only service v2 (direct SD sector reads). Original MIT code.
; Entry $1600, buffer $1D00, mailbox $1E00; ABI in Resident-driver.txt.
!cpu 4502
* = $1600
entry:
    jmp engine
finished:
    lda #$10
    sta $1e08
    lda checksum
    cmp $1e04
    lbne fail
sumlowok:
    lda checksum+1
    cmp $1e05
    lbne fail
sumhighok:
!ifdef COMPAT {
    lda $1e0e
    cmp #5
    bne notstageonly
    lda #0
    sta $1e06
    jmp cleanup
notstageonly:
}
    lda #$11
    sta $1e08
    jsr destination
    lbcs fail
destinationok:
    ; Never issue a zero-length DMA (it means 65536 bytes).
    lda staged
    ora staged+1
    lbeq succeed
nonzerocommit:
    lda staged
    sta dmacount
    lda staged+1
    sta dmacount+1
commit:
    lda #0
    sta dmasrc
    sta dmasrc+1
    lda $1e0f
    sta dmadstbank
    lda #$0f
    sta dmasrcbank
    lda #$87
    sta dmasrcmb
    lda #0
    sta dmadstmb
    lda $1e10
    sta dmadst
    lda $1e11
    sta dmadst+1
    jsr dma
    lda staged
    sta $1e1e
    lda staged+1
    sta $1e1f
    lda #0
    sta $1e06
    lda $1e0e
    beq launch
    jmp cleanup
launch:
    lda endaddress
    sta $ae
    sta $82
    lda endaddress+1
    sta $af
    sta $83
    ; Direct-mode SYS returns to the editor, which consumes RUN.
    ldx #3
keys:
    lda runtext,x
    sta $02b0,x
    dex
    bpl keys
    lda #4
    sta $d0
    bra cleanup
succeed:
    lda #0
    sta $1e06
    bra cleanup
fail:
!ifndef COMPAT {
    ldx savedsp
    txs
}
    lda $d680
    sta $1e09
    lda #2
    sta $1e06
cleanup:
    lda oldbufsel
    sta $d689
    lda olddmamb
    sta $d704
    lda olddma
    sta $d703
    lda $1e06
    cmp #2
    bne return
    lda $1e0e
    bne return
    ; A failed launch prints "?" and the six bytes at $1E08 in hex.
    lda #'?'
    jsr $ffd2
    ldx #0
diagloop:
    lda $1e08,x
    phx
    jsr printhex
    lda #32
    jsr $ffd2
    plx
    inx
    cpx #6
    bne diagloop
    lda #13
    jsr $ffd2
return:
    plp
    rts
printhex:
    pha
    lsr
    lsr
    lsr
    lsr
    jsr nibble
    pla
    and #15
nibble:
    tax
    lda hexchars,x
    jmp $ffd2
hexchars: !text "0123456789ABCDEF"
sdready:
    ; Bounded wait for the SD controller to leave BUSY; duration depends on CPU speed.
    ldx #0
    ldy #0
    lda #64
    sta ticks
sdloop:
    lda $d680
    and #3
    beq ready
    dex
    bne sdloop
    dey
    bne sdloop
    dec ticks
    bne sdloop
    sec
    rts
ready:
    clc
    rts
dma:
    lda #0
    sta $d703
    sta $d702
    sta $d704
    lda #>dmalist
    sta $d701
    lda #<dmalist
    sta $d705
    rts
dmalist:
    !byte $80
dmasrcmb: !byte 0
    !byte $81
dmadstmb: !byte 0
    !byte 0
    !byte 0
dmacount: !word 0
dmasrc: !word $1d02
dmasrcbank: !byte 0
dmadst: !word 0
dmadstbank: !byte 4
    !word 0
runtext: !text "RUN"
    !byte 13
offset: !word 0
olddma: !byte 0
olddmamb: !byte 0
oldbufsel: !byte 0
!ifndef COMPAT { savedsp: !byte 0 }
remain: !word 0
checksum: !word 0
staged: !word 0
first: !byte 0
blockcount: !byte 0
ticks: !byte 0

engine:
    php
!ifndef COMPAT {
    tsx
    stx savedsp
}
    sei
    cld
    lda #0
    sta $1e1e
    sta $1e1f
    lda $d703
    sta olddma
    lda $d704
    sta olddmamb
    lda #$47
    sta $d02f
    lda #$53
    sta $d02f
    ; $FFD6E00 shows the SD sector buffer only while $D689 bit 7 is set;
    ; otherwise it shows the F011 buffer (verified on a MEGA65 R6, core
    ; 0.97). Hyppo leaves the bit clear after mounting an image.
    lda $d689
    sta oldbufsel
    ora #$80
    sta $d689
    lda $d68b
    sta $1e0a
    lda $d68a
    sta $1e0b
    lda $1e00
    sta $1e0c
    lda $1e01
    sta $1e0d
    lda #1
    sta $1e08
    sta $1e06
    ; D68B bit 0 enables the image; bit 6 selects D65.
    lda $d68b
    and #$41
    cmp #$41
    lbne fail
mounted:
    lda #$02
    sta $1e08
    lda $d68a
    and #$40
    lbne fail
formatok:
!ifndef COMPAT {
    lda $1e0e
    cmp #8
    lbeq stream
}
    jsr lookup
    lbcs fail
!ifndef COMPAT {
    lda $1e0e
    cmp #6
    bcc notopen
    ; Commands 6/7: open for streaming. Remaining length is 24-bit. Files
    ; of 64 KiB or more keep $FFFF in the length field (so commands 1-4
    ; refuse them) and their length bits 0-15 in the byte-sum field, bits
    ; 16-23 in entry byte 23 (ABI 2).
    ldx #2
    lda $1e57
    sta $1e17
    beq openlength
    ldx #4
openlength:
    lda $1e00,x
    sta $1e15
    lda $1e01,x
    sta $1e16
    lda $1e00
    sta $1e19
    lda $1e01
    sta $1e1a
    jmp succeed
notopen:
}
sizeok:
    ; The staging area ends at $87FE000, below the catalogue. Limit both
    ; raw and PRG reads to 57344 file bytes for a simple fail-closed bound.
    lda #3
    sta $1e08
    lda $1e03
    cmp #$e0
    bcc filesizeok
    bne oversized
    lda $1e02
    beq filesizeok
oversized:
    jmp fail
filesizeok:
    lda $1e02
    sta remain
    lda $1e03
    sta remain+1
    ora remain
    bne nonempty
    lda $1e0e
    cmp #1
    beq emptyraw
    cmp #2
    lbne fail
emptyraw:
    lda #0
    sta staged
    sta staged+1
    sta checksum
    sta checksum+1
    jmp finished
nonempty:
    lda #0
    sta checksum
    sta checksum+1
    sta staged
    sta staged+1
    lda #1
    sta first
    lda $1e0e
    cmp #1
    beq rawfile
    cmp #2
!ifdef COMPAT {
    beq rawfile
    cmp #5
}
    bne notraw
rawfile:
    lda #0
    sta first
notraw:
    lda #4
    sta $1e08
    jsr sdready
    lbcs fail
next:
!ifndef COMPAT {
    jsr readblock
    jmp afterblock
}
; Read the block at track $1E00 / sector $1E01 into $1D00, leave its link
; in $1E00/$1E01 and its payload length in blockcount. Errors jump to fail,
; which restores the stack.
readblock:
    lda #$06
    sta $1e08
    lda $1e00
    beq badlink
    cmp #86
    bcs badlink
    bra validlink
badlink:
    jmp fail
validlink:
    lda $1e00
    sta $1e0c
    lda $1e01
    sta $1e0d
    ; Image sector = (track-1) * 128 + logical sector / 2: 128 half-KB
    ; sectors per D65 track (256 x 256 bytes).
    lda $1e00
    sec
    sbc #1
    lsr
    sta offset+1
    lda #0
    ror
    sta offset
trackdone:
    lda $1e01
    lsr
    clc
    adc offset
    sta offset
    bcc offsetdone
    inc offset+1
offsetdone:
    ; SD sector = mounted image start ($D68C-$D68F) + image sector. Hyppo
    ; refuses fragmented images, so every image byte has a fixed SD sector.
    ; This bypasses the F011 track/sector path, which the core clamps to
    ; 64 half-KB sectors per track, and reaches the whole 5,570,560 bytes.
    lda #7
    sta $1e08
    clc
    lda $d68c
    adc offset
    sta $d681
    lda $d68d
    adc offset+1
    sta $d682
    lda $d68e
    adc #0
    sta $d683
    lda $d68f
    adc #0
    sta $d684
    jsr sdready
    lbcs fail
issue:
    lda #$08
    sta $1e08
    lda #$02
    sta $d680
    jsr sdready
    lbcs fail
readok:
    lda #$09
    sta $1e08
    lda $d680
    and #$60
    lbne fail
buffer:
    ; Copy the wanted 256-byte half of the SD sector buffer at $FFD6E00.
    lda #$0a
    sta $1e08
    lda #$ff
    sta dmasrcmb
    lda #$0d
    sta dmasrcbank
    lda $1e01
    and #1
    clc
    adc #$6e
    sta dmasrc+1
    lda #0
    sta dmasrc
    sta dmadstmb
    sta dmadstbank
    sta dmadst
    sta dmacount
    lda #$1d
    sta dmadst+1
    lda #1
    sta dmacount+1
    jsr dma
links:
    lda #$0b
    sta $1e08
    lda $1d00
    sta $1e00
    lda $1d01
    sta $1e01
    lda #254
    ldx $1d00
    bne gotcount
    lda $1d01
    lbeq fail
terminal:
    sec
    sbc #1
gotcount:
    sta blockcount
!ifndef COMPAT {
    rts
}
afterblock:
    lda #$0c
    sta $1e08
    ; Reject blocks exceeding the declared remaining byte count.
    lda remain+1
    bne subtract
    lda remain
    cmp blockcount
    lbcc fail
subtract:
    sec
    lda remain
    sbc blockcount
    sta remain
    lda remain+1
    sbc #0
    sta remain+1
    lda #$0d
    sta $1e08
    lda remain+1
    ; Terminal pointer must agree with the length, bounding cyclic chains.
    ora remain
    bne more
    lda $1d00
    beq checksumblock
    jmp fail
more:
    lda $1d00
    bne checksumblock
    jmp fail
checksumblock:
    ldx #0
sumloop:
    cpx blockcount
    beq summed
    clc
    lda checksum
    adc $1d02,x
    sta checksum
    bcc sumcarry
    inc checksum+1
sumcarry:
    inx
    bra sumloop
summed:
    lda #2
    sta dmasrc
    lda blockcount
    sta dmacount
    lda first
    beq stage
    lda #$0e
    sta $1e08
    lda blockcount
    cmp #2
    lbcc fail
checkheader:
    lda #$0f
    sta $1e08
    lda $1e0e
    bne storedaddress
    lda $1d02
    cmp #1
    bne headerbad
    lda $1d03
    cmp #$20
    bne headerbad
storedaddress:
    lda $1d02
    sta $1e10
    lda $1d03
    sta $1e11
    bra headerok
headerbad:
    jmp fail
headerok:
    lda #0
    sta first
    lda #4
    sta dmasrc
    dec dmacount
    dec dmacount
stage:
    lda dmacount
    beq stagedone
    lda #0
    sta dmacount+1
    sta dmasrcbank
    lda #$1d
    sta dmasrc+1
    lda #$0f
    sta dmadstbank
    lda #$87
    sta dmadstmb
    lda #0
    sta dmasrcmb
    lda staged
    sta dmadst
    clc
    adc dmacount
    sta staged
    lda staged+1
    sta dmadst+1
    adc #0
    sta staged+1
    jsr dma
stagedone:
    lda remain
    ora remain+1
    bne continue
    jmp finished
continue:
    jmp next
!ifndef COMPAT {
; Command 8: copy up to $1E18 blocks (254 bytes each, the last one shorter)
; of the open file to Attic RAM at megabyte $1E14, bank $1E0F, address
; $1E10/$1E11. The destination advances, so repeated calls stream the whole
; file. Bytes copied: $1E1E/$1E1F. Remaining: $1E15-$1E17. Blocks already
; copied stay copied if a later block fails; the position is kept, so the
; call can be repeated.
stream:
    lda #$15
    sta $1e08
    lda $1e18
    sta quota
streamloop:
    lda $1e15
    ora $1e16
    ora $1e17
    lbeq succeed
    lda quota
    lbeq succeed
    ; Attic RAM megabytes $80-$86 only; $87 holds this driver's catalogue.
    lda $1e14
    cmp #$80
    lbcc fail
    cmp #$87
    lbcs fail
    lda $1e19
    sta $1e00
    lda $1e1a
    sta $1e01
    jsr readblock
    ; Remaining length bounds the chain (and any cycle in it).
    sec
    lda $1e15
    sbc blockcount
    sta remain
    lda $1e16
    sbc #0
    sta remain+1
    lda $1e17
    sbc #0
    lbcc fail
    sta $1e17
    lda remain
    sta $1e15
    lda remain+1
    sta $1e16
    lda #2
    sta dmasrc
    lda #$1d
    sta dmasrc+1
    lda blockcount
    sta left
streampart:
    ; DMA addresses wrap inside a megabyte (verified on a MEGA65 R6), so a
    ; block that crosses into the next megabyte is copied in two parts.
    lda left
    sta part
    lda $1e11
    cmp #$ff
    bne streamwhole
    lda $1e0f
    cmp #$0f
    bne streamwhole
    clc
    lda $1e10
    adc part
    bcc streamwhole
    beq streamwhole
    lda #0
    sec
    sbc $1e10
    sta part
streamwhole:
    ldx #2
streamdma:
    lda $1e0f,x
    sta dmadst-1,x
    dex
    bne streamdma
    lda $1e0f
    sta dmadstbank
    lda $1e14
    sta dmadstmb
    stx dmasrcmb
    stx dmasrcbank
    stx dmacount+1
    lda part
    sta dmacount
    jsr dma
    clc
    lda dmasrc
    adc part
    sta dmasrc
    clc
    lda $1e10
    adc part
    sta $1e10
    bcc streamrest
    inc $1e11
    bne streamrest
    inc $1e0f
    lda $1e0f
    and #$0f
    bne streamrest
    sta $1e0f
    inc $1e14
streamrest:
    sec
    lda left
    sbc part
    sta left
    lbne streampart
    lda $1e00
    sta $1e19
    lda $1e01
    sta $1e1a
streamcount:
    clc
    lda $1e1e
    adc blockcount
    sta $1e1e
    bcc streamnext
    inc $1e1f
streamnext:
    dec quota
    jmp streamloop
quota: !byte 0
left: !byte 0
part: !byte 0
}

; All executable code remains in the documented $1600-$1CFF utility area.
; Attic $87FE000-$87FFFFF holds the catalogue; $87F0000-$87FDFFF stages reads.
; No ROM vectors or undocumented KERNAL variables are used by file service.
lookup:
    lda #$12
    sta $1e08
    lda $1e0e
!ifdef COMPAT { cmp #6 } else { cmp #8 }
    bcc commandok
    sec
    rts
commandok:
    lda #8
    sta dmacount
    lda #0
    sta dmacount+1
    sta dmasrc
    lda #$e0
    sta dmasrc+1
    lda #$0f
    sta dmasrcbank
    lda #$87
    sta dmasrcmb
    lda #0
    sta dmadstmb
    lda #$40
    sta dmadst
    lda #$1e
    sta dmadst+1
    lda #0
    sta dmadstbank
    jsr dma
    ldx #3
signaturecheck:
    lda $1e40,x
    cmp signature,x
    bne lookupbad
    dex
    bpl signaturecheck
    lda $1e44
    cmp #2
    bne lookupbad
    lda $1e45
    sta entriesleft
    lda $1e46
    sta entriesleft+1
    cmp #2
    bcs lookupbad
    cmp #1
    bne countlow
    lda entriesleft
    cmp #40
    bcs lookupbad
countlow:
    lda entriesleft
    ora entriesleft+1
    beq lookupbad
    lda #8
    sta catalogptr
    lda #$e0
    sta catalogptr+1
    lda #0
    sta currentindex
    sta currentindex+1
    lda $1e0e
    bne lookupnext
    sta $1e0f
    bra lookupnext
lookupbad:
    sec
    rts
lookupnext:
    lda catalogptr
    sta dmasrc
    lda catalogptr+1
    sta dmasrc+1
    lda #24
    sta dmacount
    jsr dma
    lda $1e0e
    cmp #2
    beq matchname
    cmp #3
    beq matchname
!ifndef COMPAT {
    cmp #7
    beq matchname
}
!ifdef COMPAT {
    cmp #5
    beq matchname
}
    lda currentindex
    cmp $1e12
    bne advance
    lda currentindex+1
    cmp $1e13
    beq matched
    bra advance
matchname:
    ldx #15
matchloop:
    lda $1e40,x
    cmp $1e20,x
    bne advance
    dex
    bpl matchloop
    bra matched
advance:
    clc
    lda catalogptr
    adc #24
    sta catalogptr
    bcc pointerdone
    inc catalogptr+1
pointerdone:
    inc currentindex
    bne indexdone
    inc currentindex+1
indexdone:
    lda entriesleft
    bne decrem
    dec entriesleft+1
decrem:
    dec entriesleft
    lda entriesleft
    ora entriesleft+1
    bne lookupnext
    lda #$13
    sta $1e08
    sec
    rts
matched:
    ldx #5
parameters:
    lda $1e50,x
    sta $1e00,x
    dex
    bpl parameters
    lda $1e0e
    cmp #1
    beq lookupok
    cmp #2
    beq lookupok
!ifndef COMPAT {
    cmp #6
    bcs lookupok
}
    lda $1e56
    cmp #2
    beq lookupok
    sec
    rts
lookupok:
    clc
    rts
; Keep all writes within BASIC program/data RAM in bank 0 or 1. This
; protects this driver, the ROM, colour window, catalogue, and staging.
destination:
    lda #$14
    sta $1e08
    lda $1e0f
    cmp #2
    bcs destbad
    lda $1e11
    cmp #$20
    bcc destbad
    clc
    lda $1e10
    adc staged
    sta endaddress
    lda $1e11
    adc staged+1
    sta endaddress+1
    bcs destbad
    cmp #$f7
    bcc destok
    bne destbad
    lda endaddress
    bne destbad
destok:
    clc
    rts
destbad:
    sec
    rts
signature: !text "D65R"
entriesleft: !word 0
currentindex: !word 0
catalogptr: !word 0
endaddress: !word 0
!if * > $1d00 { !error "Driver exceeds utility code area" }

!ifdef COMPAT { !if * > $1c40 { !error "Compatibility reader overlaps gateway" } }
