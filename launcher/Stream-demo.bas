10 REM STREAM A LARGE FILE FROM THE D65 INTO ATTIC RAM (RESIDENT READER ABI 2)
20 BANK 0:M=7680:F$="SPACE.SCP"
30 FOR I=0 TO 15:POKE M+32+I,160:NEXT
40 FOR I=1 TO LEN(F$):POKE M+31+I,ASC(MID$(F$,I,1)):NEXT
50 POKE M+14,7:SYS 5632
60 IF PEEK(M+6) THEN PRINT "OPEN FAILED, STAGE";PEEK(M+8):END
70 L=PEEK(M+21)+256*PEEK(M+22)+65536*PEEK(M+23)
80 PRINT F$;L;"BYTES -> $8000000"
90 POKE M+20,128:POKE M+15,0:POKE M+16,0:POKE M+17,0:T=0
100 POKE M+14,8:POKE M+24,200:SYS 5632
110 IF PEEK(M+6) THEN PRINT:PRINT "READ FAILED, STAGE";PEEK(M+8):END
120 N=PEEK(M+30)+256*PEEK(M+31):T=T+N
130 IF N THEN PRINT ".";:GOTO 100
140 PRINT:PRINT "STREAMED";T;"BYTES"
150 IF T=L THEN PRINT "STREAM OK":END
160 PRINT "LENGTH MISMATCH"
